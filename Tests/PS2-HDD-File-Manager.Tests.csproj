<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>PfsExplorerLite.Tests</RootNamespace>
    <AssemblyName>PS2-HDD-File-Manager.Tests</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <!-- 旧 Actions 的入口适配：测试源码仍归 Windows 客户端所有。 -->
    <Compile Include="..\Windows\Tests\Program.cs" Link="Program.cs" />
    <ProjectReference Include="..\Windows\PS2-HDD-File-Manager.csproj"
                      AdditionalProperties="BaseOutputPath=$(MSBuildProjectDirectory)\..\bin\;_ReleaseZipDir=$(MSBuildProjectDirectory)\..\bin\Release" />
  </ItemGroup>
</Project>
